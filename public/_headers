# public/_headers — Cloudflare applies these to STATIC files served from the assets directory only, never to worker-rendered HTML
# (page security headers come from next.config headers() or middleware — test them with check-headers / check-live).
# `immutable` is only safe for fingerprinted (content-hashed) filenames like /_next/static/*. A replaced /art/hero.webp keeps its name,
# so returning visitors would never see the new file: art gets one day + background refresh instead.
# The service worker must never come from a cache: the browser checks it for updates on every visit.
/sw.js
  Cache-Control: no-cache

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
