{
  "$comment": "Read by .hk-template/hk-init.mjs. Conditions use the module names auth and offline with !, && and ||. This folder deletes itself after hk:init runs.",
  "markerFiles": [
    "src/middleware.ts",
    "src/components/Header.tsx",
    "src/app/layout.tsx",
    "src/app/page.tsx",
    "e2e/a11y.spec.ts",
    "e2e/csp.spec.ts",
    "e2e/golden-path.spec.ts",
    ".env.example"
  ],
  "remove": [
    { "unless": "auth", "paths": ["src/modules/auth", "src/app/login", "src/app/auth", "src/app/account", "src/lib/reload-to.ts", "supabase", "docs/SUPABASE_SETUP.md", ".github/workflows/keep-awake.yml", "e2e/auth.spec.ts"] },
    { "unless": "offline", "paths": ["src/modules/offline", "public/sw.js", "public/icons", "src/app/manifest.ts", "src/app/offline", "e2e/offline.spec.ts", "e2e/notes.spec.ts"] },
    { "unless": "auth && offline", "paths": ["src/modules/synced"] },
    { "unless": "auth || offline", "paths": ["src/app/notes", "src/lib/notes/active.ts"] }
  ],
  "variants": [
    { "when": "auth && !offline", "from": "variants/auth" },
    { "when": "offline && !auth", "from": "variants/offline" }
  ],
  "dependencies": [
    { "unless": "auth", "names": ["@supabase/ssr", "@supabase/supabase-js"] },
    { "unless": "offline", "names": ["idb", "fake-indexeddb"] }
  ],
  "smoke": [
    { "unless": "auth || offline", "paths": ["/notes"] },
    { "unless": "auth", "paths": ["/login"] },
    { "unless": "offline", "paths": ["/offline", "/manifest.webmanifest", "/sw.js"] }
  ],
  "alsoRemove": [".hk-template", ".github/workflows/template.yml"]
}
