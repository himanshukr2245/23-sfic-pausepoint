# Names only — real values live in .env.local (your machine), Workers Builds → Build variables (NEXT_PUBLIC_*),
# and Worker → Settings → Variables and Secrets (server secrets). Never put a secret behind NEXT_PUBLIC_ (SEC-1, STK-4).

# Public, build-time (inlined into the bundle)
NEXT_PUBLIC_SITE_URL=
# #if auth
# Supabase → Project Settings → API Keys: the project URL and the PUBLISHABLE key (sb_publishable_…, never the secret key).
# Empty = guest mode: no sign-in, notes stay on the device — the app still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# #endif

# #if auth
# rls-proof and the real-account e2e test only (throwaway test accounts on the starter's own Supabase project) — local .env.local,
# never committed
TEST_AUTH_EMAIL=
TEST_AUTH_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
RLS_A_EMAIL=
RLS_A_PASSWORD=
RLS_B_EMAIL=
RLS_B_PASSWORD=
# #endif
